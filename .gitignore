# Obsidian settings can contain credentials, private sync configuration and caches.
# Keep only the non-secret enabled-plugin inventory.
.obsidian/*
!.obsidian/community-plugins.json
**/.obsidian/**
!/.obsidian/community-plugins.json
.trash/
**/.git/
node_modules/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.log
Thumbs.db
.DS_Store
~$*
